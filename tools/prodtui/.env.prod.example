# Copy to .env.prod (gitignored) and fill in. Only DB_URL is required;
# the rest have sane defaults baked in (see config.go).

# Full prod connection string — points at the LOCAL forwarded port (the tunnel),
# NOT the server. Password lives only here, never in git.
DB_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15432/burdych.net

